# Copy to .env and replace every CHANGE_ME value before deployment.
NODE_ENV=production
URL=https://docs.makiapp.ru
PORT=3000
FORCE_HTTPS=true
PROXY_HEADERS_TRUSTED=true

# Generate each with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
UTILS_SECRET=CHANGE_ME_64_HEX_CHARACTERS

# Use a long, unique password. Repeat it in DATABASE_URL after URL-encoding
# characters such as @, :, /, ?, and #.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://outline:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
ENABLE_UPDATES=true

# Required for the existing email magic-link recovery flow and first password setup.
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=Outline <docs@makiapp.ru>
SMTP_SECURE=false
